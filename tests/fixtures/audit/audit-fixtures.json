{
  "schemaVersion": "policystrata.audit_fixtures.v1",
  "reviewerFeedbackFormat": {
    "schemaVersion": "policystrata.reviewer_feedback.v1",
    "fields": ["findingId", "reviewer", "disposition", "reason", "createdAt"],
    "dispositions": ["confirmed", "false_positive", "needs_more_evidence", "waived"]
  },
  "qualityTracking": {
    "falseNegatives": {
      "fields": ["auditCaseId", "missedControl", "rootCause", "regressionTestRef"]
    },
    "noisyFalsePositives": {
      "fields": ["auditCaseId", "findingId", "noiseReason", "tuningRef"]
    }
  },
  "cases": [
    {
      "id": "metadata_only_enforcement",
      "title": "Product metadata-only enforcement",
      "kind": "metadata_boundary",
      "expectedControl": "metadata_only_boundary",
      "fixtureRefs": ["runtime-events/redacted-event.json"],
      "metadataOnly": true
    },
    {
      "id": "redaction_audit",
      "title": "Redaction removes prompts, rows, documents, and tool payloads",
      "kind": "redaction",
      "expectedControl": "pii_secret_minimization",
      "fixtureRefs": ["payloads/redaction-negative.json"],
      "metadataOnly": true
    },
    {
      "id": "tenant_isolation_audit",
      "title": "Tenant isolation blocks cross-tenant retrieval and SQL",
      "kind": "tenant_isolation",
      "expectedControl": "tenant_scope_required",
      "fixtureRefs": ["runtime-events/cross-tenant-retrieval.json"],
      "metadataOnly": true
    },
    {
      "id": "runner_token_abuse",
      "title": "Runner token missing or invalid fails upload closed",
